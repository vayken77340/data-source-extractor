# Copy to .env and fill in. This file is the only documentation of what a source
# needs to run, so every `env:` reference in config/sources/ belongs here.
#
# Vars are namespaced by source — several sources will each have something
# called "token".
#
# Note: a literal string starting with "env:" is not escapable. It is read as a
# reference and fails the config.env.vars_set check at validate time with a
# clear message, so it never reaches the wire.

# thingsboard
TB_USER=
TB_PASSWORD=
